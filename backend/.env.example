# ==============================================================================
# Truck Hauling & Fleet Management System - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND UPDATE SENSITIVE VALUES BEFORE RUNNING IN PRODUCTION.
# NEVER COMMIT .env CONTAINING REAL SECRETS TO VERSION CONTROL!

# Server Environment: development | production | release
ENV=production
GIN_MODE=release

# Application Server Port
PORT=8088

# MongoDB Connection String
# For local service: mongodb://127.0.0.1:27017
# For secured cluster: mongodb://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017

# Database Name
MONGO_DB_NAME=truck_fleet_db

# JWT Secret Key - MUST BE A STRONG RANDOM VALUE IN PRODUCTION (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-32-byte-secret-key-in-production

# CORS Allowed Origins (Comma-separated list of allowed URLs)
# In production, specify exact client origins (e.g. https://fleet.yourcompany.com)
# Avoid using '*' in production environments.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Trusted Reverse Proxy IP addresses or CIDR blocks (comma-separated)
# Leave empty if backend is directly exposed or if not running behind a trusted reverse proxy (e.g. Nginx, Cloudflare)
TRUSTED_PROXIES=127.0.0.1
