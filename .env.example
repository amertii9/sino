# ==========================================
# Root Docker Environment Configuration
# ==========================================
# Application Environment
ENV=production
GIN_MODE=release

# Port Mappings
FRONTEND_PORT=6060
BACKEND_PORT=6061

# Backend Security & Database
# Generate a strong 32+ char key: openssl rand -base64 32
JWT_SECRET=change-this-to-a-very-secure-random-secret-key-32-chars

# MongoDB URI (default connects to docker service 'mongodb')
# If using external MongoDB / Atlas, set: mongodb+srv://<user>:<password>@cluster.mongodb.net/truck_fleet_db
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=truck_fleet_db

# CORS Allowed Origins (Comma-separated)
# In production, set to your actual domain(s), e.g., https://yourdomain.com
CORS_ORIGINS=http://localhost:6060,http://localhost:6061,https://yourdomain.com

# Frontend API URL configuration
# Keep as /api when using the built-in Nginx reverse proxy
VITE_API_URL=/api
